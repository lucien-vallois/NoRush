# NoRush local demonstration. Prefer npm run setup:demo to generate unique secrets.
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowback_iot
DB_USER=flowback_user
DB_PASS=secure_password
DB_SSL=false

# Required unique values. setup:demo generates these without printing them.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d
# Shared gateway credential; include as authToken in MQTT/HTTP payloads.
IOT_INGEST_KEY=replace-with-a-random-ingestion-secret
# Ingestion auth: shared (demo key) | device (per-device credential from /devices) | hybrid
IOT_AUTH_MODE=shared

# Gauge reports: local hour the gauge day starts, and the pad's IANA time zone
# (the console sends the browser's time zone; these are defaults for direct API calls)
GAUGE_DAY_START_HOUR=7
GAUGE_DAY_TIMEZONE=America/Chicago

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# mqtts + 8883 for TLS; see docs/hardware-integration.md
MQTT_PROTOCOL=mqtt
# false only for a local self-signed broker during bring-up
MQTT_REJECT_UNAUTHORIZED=true
MQTT_TOPIC_SENSOR_DATA=sensors/data
MQTT_TOPIC_ALERTS=alerts
MQTT_TOPIC_COMMANDS=commands
MQTT_QOS=1

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=flowback
RABBITMQ_PASS=flowback_dev
RABBITMQ_VHOST=

VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000

SIM_INTERVAL=5000
SIM_DURATION=300000
SIM_SPEED=60
# Per-device credential (overrides IOT_INGEST_KEY) for bring-up tests
# SIM_DEVICE_TOKEN=nrk_...

DOCKER_DB_PORT=5432
DOCKER_MQTT_PORT=1883
DOCKER_RABBITMQ_PORT=5672
DOCKER_REDIS_PORT=6379
