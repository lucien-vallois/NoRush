# NoRush local demonstration. Prefer npm run setup:demo to generate unique secrets.
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
# Proxy hops in front of the API (1 behind nginx or Railway; Railway sets it
# automatically). Leave unset when the API is exposed directly.
# TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowback_iot
DB_USER=flowback_user
DB_PASS=secure_password
DB_SSL=false
# Hosted PostgreSQL (Railway, Neon, Supabase): any DB_* left unset is taken
# from DATABASE_URL, then from PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
# DATABASE_URL=postgres://flowback_user:secure_password@localhost:5432/flowback_iot

# Required unique values. setup:demo generates these without printing them.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d
# Shared gateway credential; include as authToken in MQTT/HTTP payloads.
IOT_INGEST_KEY=replace-with-a-random-ingestion-secret
# Ingestion auth: shared (demo key) | device (per-device credential from /devices) | hybrid
IOT_AUTH_MODE=shared
# Seeds the demo tanks, gauges and accounts at startup when the database has
# no tanks (useful on a hosted demo; npm run seed does the same locally)
DEMO_AUTO_SEED=true
# Public demo with shared accounts: refuse setup changes (tanks, gauges,
# credentials, users); sign-in, ingestion and alert actions stay open
DEMO_READ_ONLY=false

# Gauge reports: local hour the gauge day starts, and the pad's IANA time zone
# (the console sends the browser's time zone; these are defaults for direct API calls)
GAUGE_DAY_START_HOUR=7
GAUGE_DAY_TIMEZONE=America/Chicago

# false: HTTP-only deployment without a broker (health shows MQTT as disabled)
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# mqtts + 8883 for TLS; see docs/hardware-integration.md
MQTT_PROTOCOL=mqtt
# false only for a local self-signed broker during bring-up
MQTT_REJECT_UNAUTHORIZED=true
MQTT_TOPIC_SENSOR_DATA=sensors/data
MQTT_TOPIC_ALERTS=alerts
MQTT_TOPIC_COMMANDS=commands
MQTT_QOS=1

# false: skip the optional derived events (readings are stored either way)
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=flowback
RABBITMQ_PASS=flowback_dev
RABBITMQ_VHOST=

VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
# npm start (vite preview) answers *.up.railway.app; add custom domains here
# PREVIEW_ALLOWED_HOSTS=demo.example.com

SIM_INTERVAL=5000
# 0 = run until stopped (a hosted simulator worker); default 60000
SIM_DURATION=300000
SIM_SPEED=60
# simulate:http target; takes precedence over HTTP_HOST/HTTP_PORT
# HTTP_URL=https://your-api.up.railway.app
# Per-device credential (overrides IOT_INGEST_KEY) for bring-up tests
# SIM_DEVICE_TOKEN=nrk_...

DOCKER_DB_PORT=5432
DOCKER_MQTT_PORT=1883
DOCKER_RABBITMQ_PORT=5672
DOCKER_REDIS_PORT=6379
